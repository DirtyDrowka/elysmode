# Скопировать в .env (для локального docker-compose) или вставить в Dockploy
# как Environment Variables.

# GHCR owner (твой GitHub username или org)
GHCR_OWNER=your-github-username

# Postgres
POSTGRES_USER=elysmode
POSTGRES_PASSWORD=замените-на-длинный-пароль
POSTGRES_DB=elysmode

# JWT — сгенерить:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=замените-на-32-байтовый-секрет

# Telegram bot — от @BotFather
TG_BOT_TOKEN=

# ElevenLabs — TTS
ELEVENLABS_API_KEY=sk_...

# OpenRouter — LLM сюжета + Recraft картинки
VITE_OPENROUTER_KEY=sk-or-v1-...
VITE_OPENROUTER_MODEL=x-ai/grok-4.3

# Cloudflare Tunnel token (из CF Dashboard → Zero Trust → Networks → Tunnels)
CF_TUNNEL_TOKEN=eyJh...

# Домен фронта (для CORS на бэке)
FRONTEND_ORIGIN=https://bidons.elys.mom

# URL бэка с точки зрения браузера. ВНИМАНИЕ: это build-time env для frontend
# образа — указывается через GitHub Actions secret или в Dockploy → Build args.
# На runtime не нужен.
VITE_API_BASE_URL=https://molochko.elys.mom

# Прокси (если сервер в РФ — ElevenLabs и OpenRouter гео-блокируют)
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=postgres,localhost,127.0.0.1
