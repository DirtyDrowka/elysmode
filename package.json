{
  "name": "elysmode",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c blue,magenta \"npm run web\" \"npm run server\"",
    "web": "vite --host 0.0.0.0",
    "server": "tsx watch --env-file=.env server/index.ts",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "tsx server/migrate.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14",
    "jimp": "^1.6.1",
    "jsonwebtoken": "^9.0.2",
    "postgres": "^3.4.5",
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^24.12.3",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vue-tsc": "^3.2.8"
  }
}
